{
  "$schema": "https://logihertz.com/schemas/sdr-waterfall-v1.json",
  "dashboard_id": "lh-sdr-telemetry-orin-01",
  "organization": "Logihertz Systems (OPC) Private Limited",
  "websocket_url": "wss://sdr-hub.internal.logihertz.com:8443/telemetry",
  "websocket_tls_enabled": true,
  "websocket_auth_required": true,
  "fft_size": 1024,
  "sample_rate_hz": 2400000,
  "max_waterfall_history_rows": 1024,
  "webgl_context_loss_handler": true,
  "window_function": "blackman-harris",
  "sidelobe_suppression_db": 92.0,
  "target_fps": 60,
  "max_websocket_mbps": 20.0,
  "min_dbfs": -120.0,
  "max_dbfs": -10.0,
  "redact_sensitive_freq_labels": true,
  "expose_receiver_gps_coords": false,
  "fft_shift_dc_centered": true,
  "apply_coherent_gain_correction": true,
  "strict_csp_enabled": true,
  "shared_array_buffer_coop_coep": true,
  "ema_alpha": 0.25,
  "adc_overload_banner_enabled": true,
  "colormap": "turbo"
}
