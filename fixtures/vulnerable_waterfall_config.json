{
  "$schema": "https://logihertz.com/schemas/sdr-waterfall-v1.json",
  "dashboard_id": "unhardened-test-dashboard-99",
  "organization": "Unverified Test Entity",
  "websocket_url": "ws://0.0.0.0:8080/raw-iq",
  "websocket_tls_enabled": false,
  "websocket_auth_required": false,
  "fft_size": 500,
  "sample_rate_hz": 2400000,
  "max_waterfall_history_rows": 8192,
  "webgl_context_loss_handler": false,
  "window_function": "rectangular",
  "sidelobe_suppression_db": 13.0,
  "target_fps": 144,
  "max_websocket_mbps": 120.0,
  "min_dbfs": -20.0,
  "max_dbfs": 5.0,
  "redact_sensitive_freq_labels": false,
  "expose_receiver_gps_coords": true,
  "fft_shift_dc_centered": false,
  "apply_coherent_gain_correction": false,
  "strict_csp_enabled": false,
  "shared_array_buffer_coop_coep": false,
  "ema_alpha": 0.0,
  "adc_overload_banner_enabled": false,
  "colormap": "radar-green"
}
